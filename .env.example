# --- LiveKit Cloud ---
# From your LiveKit Cloud project settings (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Anthropic (AI PDF extraction, extraction-only) ---
ANTHROPIC_API_KEY=
# Model used for extraction. Opus for accuracy, Sonnet for cost.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sigunu?schema=public

# --- Redis (optional at single-node; enables scalable Socket.IO fan-out + leaderboard cache) ---
REDIS_URL=redis://localhost:6379

# --- Server ---
PORT=4000
# Comma-separated allowed web origins for CORS
WEB_ORIGIN=http://localhost:5173

# --- Web (Vite, must be VITE_ prefixed) ---
VITE_API_URL=http://localhost:4000
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
